#!/bin/sh
set -eu

php-fpm84 -F &
fpm_pid=$!

terminate() {
    trap - TERM INT EXIT
    kill -TERM "$fpm_pid" "$nginx_pid" 2>/dev/null || true
    wait "$fpm_pid" 2>/dev/null || true
    wait "$nginx_pid" 2>/dev/null || true
}

trap 'terminate; exit 143' TERM
trap 'terminate; exit 130' INT
trap terminate EXIT

nginx -g 'daemon off;' &
nginx_pid=$!

while kill -0 "$fpm_pid" 2>/dev/null && kill -0 "$nginx_pid" 2>/dev/null; do
    sleep 1
done

if ! kill -0 "$fpm_pid" 2>/dev/null; then
    wait "$fpm_pid" 2>/dev/null || status=$?
else
    wait "$nginx_pid" 2>/dev/null || status=$?
fi

exit "${status:-0}"
